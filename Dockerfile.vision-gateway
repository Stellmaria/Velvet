FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VISION_GATEWAY_HOST=0.0.0.0 \
    VISION_GATEWAY_PORT=8080

RUN groupadd --gid 10001 velvet \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin velvet

WORKDIR /app
COPY requirements.vision-gateway.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY --chown=10001:10001 vision_gateway /app/vision_gateway

USER 10001:10001

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=4 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=4).read()"]

CMD ["python", "-m", "vision_gateway.app"]
