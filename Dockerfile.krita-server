FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/velvet \
    XDG_CONFIG_HOME=/home/velvet/.config \
    XDG_DATA_HOME=/home/velvet/.local/share \
    XDG_CACHE_HOME=/home/velvet/.cache \
    PYTHONDONTWRITEBYTECODE=1 \
    NO_AT_BRIDGE=1 \
    QT_OPENGL=software \
    QT_QUICK_BACKEND=software \
    QT_XCB_GL_INTEGRATION=none \
    LIBGL_ALWAYS_SOFTWARE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        dbus-x11 \
        fonts-dejavu-core \
        krita \
        libgl1-mesa-dri \
        python3 \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 velvet \
    && mkdir -p \
        /home/velvet/.cache \
        /home/velvet/.config \
        /home/velvet/.local/share/krita/pykrita \
        /app/runtime/krita \
    && printf '[python]\nenable_velvet_logo=true\n' > /home/velvet/.config/kritarc \
    && chown -R velvet:velvet /home/velvet /app

COPY --chown=10001:10001 tools/krita/velvet_logo.desktop \
    /home/velvet/.local/share/krita/pykrita/velvet_logo.desktop
COPY --chown=10001:10001 tools/krita/velvet_logo \
    /home/velvet/.local/share/krita/pykrita/velvet_logo
COPY --chown=10001:10001 deploy/krita-server/entrypoint.sh \
    /usr/local/bin/velvet-krita-entrypoint
COPY scripts/krita_server_healthcheck.py \
    /usr/local/bin/krita_server_healthcheck.py

RUN chmod 0755 \
    /usr/local/bin/velvet-krita-entrypoint \
    /usr/local/bin/krita_server_healthcheck.py

USER velvet
WORKDIR /home/velvet

HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=3 \
    CMD ["python3", "/usr/local/bin/krita_server_healthcheck.py"]

ENTRYPOINT ["/usr/local/bin/velvet-krita-entrypoint"]
