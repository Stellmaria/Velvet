# Добавьте эти значения в production .env.server только после базового VPS smoke-test.
KRITA_WATERMARK_ENABLED=false
KRITA_REMOTE_WORKER_ENABLED=false
KRITA_REMOTE_BIND_HOST=127.0.0.1
KRITA_REMOTE_ALLOW_UNSAFE_PUBLIC_BIND=false
KRITA_REMOTE_PORT=8766
KRITA_REMOTE_HOST_PORT=8766
KRITA_REMOTE_WORKER_TOKEN=replace_with_random_url_safe_secret_at_least_32_characters
KRITA_REMOTE_LEASE_SECONDS=180
KRITA_REMOTE_MAX_UPLOAD_BYTES=52428800
KRITA_REMOTE_MAX_CONCURRENT_UPLOADS=2
KRITA_REMOTE_REQUEST_TIMEOUT_SECONDS=120
KRITA_REMOTE_AUTH_FAILURE_LIMIT=5
KRITA_REMOTE_AUTH_FAILURE_WINDOW_SECONDS=60
KRITA_REMOTE_AUTH_FAILURE_COOLDOWN_SECONDS=120
KRITA_BRIDGE_DIR=/app/runtime/krita

# Windows worker environment. Токен должен совпадать с VPS.
VELVET_KRITA_API_URL=http://127.0.0.1:8766
VELVET_KRITA_WORKER_TOKEN=replace_with_same_remote_worker_token
VELVET_KRITA_WORKER_ID=krita-windows-01
VELVET_KRITA_BRIDGE_DIR=E:\VelvetKritaBridge
VELVET_KRITA_POLL_SECONDS=3
VELVET_KRITA_HEARTBEAT_SECONDS=20
VELVET_KRITA_HTTP_TIMEOUT_SECONDS=60
VELVET_KRITA_JOB_TIMEOUT_SECONDS=1800
