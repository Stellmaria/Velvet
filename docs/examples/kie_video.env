# Kie.ai image-to-video routes used by Мяу → Оживить.
# Copy these values into the server .env. Keep KIE_API_KEY private.

KIE_ENABLED=true
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/api/v1
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_USD_TO_RUB=

# Runtime: up to four paid generations in parallel, eleven attempts per task.
KIE_MAX_CONCURRENT_GENERATIONS=4
KIE_GENERATION_MAX_ATTEMPTS=11

# Provider model ids
KIE_GROK_IMAGINE_IMAGE_TO_VIDEO_MODEL=grok-imagine/image-to-video
KIE_SEEDANCE_15_PRO_MODEL=bytedance/seedance-1.5-pro
KIE_WAN_26_IMAGE_TO_VIDEO_MODEL=wan/2-6-image-to-video

# Grok v1 pricing, USD per generated second
KIE_GROK_480P_USD_PER_SECOND=0.008
KIE_GROK_720P_USD_PER_SECOND=0.015

# Seedance 1.5 Pro pricing, USD per generated second.
# Audio is priced separately because generate_audio increases provider cost.
KIE_SEEDANCE_15_480P_NO_AUDIO_USD_PER_SECOND=0.00875
KIE_SEEDANCE_15_720P_NO_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_1080P_NO_AUDIO_USD_PER_SECOND=0.0375
KIE_SEEDANCE_15_480P_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_720P_AUDIO_USD_PER_SECOND=0.035
KIE_SEEDANCE_15_1080P_AUDIO_USD_PER_SECOND=0.075

# Wan 2.6 pricing, USD per generated second.
KIE_WAN_26_720P_USD_PER_SECOND=0.07
KIE_WAN_26_1080P_USD_PER_SECOND=0.105

# The values above are operational defaults for the bot budget guard.
# Update them in the server .env whenever Kie changes account pricing.
