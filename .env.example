BOT_TOKEN=insert_telegram_bot_token_here
DATABASE_URL=postgresql://velvet:velvet_password@localhost:5432/velvet
ALLOWED_USERNAMES=
ALLOWED_USER_IDS=insert_owner_telegram_user_id
MODERATOR_USER_IDS=
LOG_CHAT_ID=
ANALYTICS_CHANNEL_IDS=
ADULT_CHANNEL_ID=-1003951213065
PUBLICATION_TIMEZONE=Europe/Berlin
BACKUP_DIR=backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Параметры контейнерного PostgreSQL. Используются docker-compose.yml.
POSTGRES_DB=velvet
POSTGRES_USER=velvet
POSTGRES_PASSWORD=replace_with_a_long_database_password
POSTGRES_PORT=5432

# Единый ключ облачного AI-шлюза. Для Byesu base_url заканчивается на /v1.
# Настоящий ключ храните только в серверном .env и никогда не коммитьте.
BYESU_API_KEY=replace_with_cloud_api_key

# Облачная vision-language модель. Ollama оставлен только как legacy/deprecated
# совместимость старого кода и не должен включаться в новой конфигурации.
AI_VISION_ENABLED=false
AI_VISION_PROVIDER=openai_compatible
AI_VISION_BASE_URL=https://byesu.com/v1
AI_VISION_MODEL=replace_with_flash_vision_model_name
AI_VISION_COMPARE_MODEL=
AI_VISION_FALLBACK_MODEL=
AI_VISION_API_KEY=
AI_VISION_TIMEOUT_SECONDS=300
AI_VISION_MAX_ATTEMPTS=3

# Каскад смыслового VL-анализа. Пустые provider/base_url/api_key наследуют
# AI_VISION_*. FLASH обязателен. PRO включается только при низкой confidence или
# ошибке Flash. SENSITIVE включается по явному режиму либо после provider refusal.
AI_VISION_CASCADE_CONFIDENCE_THRESHOLD=70
AI_VISION_PROMPT_VERSION=1
# По умолчанию direct polling остаётся включённым. После server smoke-test
# queue mode заменяет его на подтверждаемые VL-партии с PostgreSQL progress.
AI_VISION_QUEUE_ENABLED=false
AI_VISION_BATCH_PLAN_TTL_SECONDS=900

AI_VISION_FLASH_PROVIDER=
AI_VISION_FLASH_BASE_URL=
AI_VISION_FLASH_MODEL=
AI_VISION_FLASH_API_KEY=
AI_VISION_FLASH_TIMEOUT_SECONDS=300
AI_VISION_FLASH_MAX_ATTEMPTS=2
AI_VISION_FLASH_INPUT_RUB_PER_1M=
AI_VISION_FLASH_OUTPUT_RUB_PER_1M=

AI_VISION_PRO_PROVIDER=
AI_VISION_PRO_BASE_URL=
AI_VISION_PRO_MODEL=
AI_VISION_PRO_API_KEY=
AI_VISION_PRO_TIMEOUT_SECONDS=300
AI_VISION_PRO_MAX_ATTEMPTS=2
AI_VISION_PRO_INPUT_RUB_PER_1M=
AI_VISION_PRO_OUTPUT_RUB_PER_1M=

AI_VISION_SENSITIVE_PROVIDER=
AI_VISION_SENSITIVE_BASE_URL=
AI_VISION_SENSITIVE_MODEL=
AI_VISION_SENSITIVE_API_KEY=
AI_VISION_SENSITIVE_TIMEOUT_SECONDS=300
AI_VISION_SENSITIVE_MAX_ATTEMPTS=2
AI_VISION_SENSITIVE_INPUT_RUB_PER_1M=
AI_VISION_SENSITIVE_OUTPUT_RUB_PER_1M=

# Облачная текстовая модель для личной ролевой игры. Провайдеры:
# openai — Responses API; openai_compatible — /chat/completions.
AI_TEXT_ENABLED=false
AI_TEXT_PROVIDER=openai_compatible
AI_TEXT_BASE_URL=https://byesu.com/v1
AI_TEXT_MODEL=replace_with_roleplay_model_name
AI_TEXT_API_KEY=
AI_TEXT_TIMEOUT_SECONDS=300
AI_TEXT_MAX_ATTEMPTS=2
AI_TEXT_MAX_OUTPUT_TOKENS=3000
AI_TEXT_MAX_HISTORY_MESSAGES=40
# Цена в рублях за 1 млн токенов. При включённой модели хотя бы одна цена
# должна быть больше нуля, иначе бот запрещает неметрированный provider call.
AI_TEXT_INPUT_RUB_PER_1M=
AI_TEXT_OUTPUT_RUB_PER_1M=

# Необязательный облачный fallback. Он должен использовать отдельную облачную
# модель или отдельный endpoint; локальная модель больше не считается резервом.
AI_TEXT_FALLBACK_PROVIDER=
AI_TEXT_FALLBACK_BASE_URL=https://byesu.com/v1
AI_TEXT_FALLBACK_MODEL=
AI_TEXT_FALLBACK_API_KEY=
AI_TEXT_FALLBACK_INPUT_RUB_PER_1M=
AI_TEXT_FALLBACK_OUTPUT_RUB_PER_1M=

# Общий бюджет AI в рублях. Guard проверяет оценку до запроса и сохраняет
# отдельный аварийный резерв для Hermes. Фактические токены и стоимость
# записываются в PostgreSQL через ai_usage_events.
AI_BUDGET_ENABLED=true
AI_DAILY_BUDGET_RUB=500
AI_MONTHLY_BUDGET_RUB=5000
AI_MAX_REQUEST_RUB=250
AI_HERMES_RESERVE_RUB=300
AI_BUDGET_WARNING_PERCENTS=70,85,95

# Генерация изображений и видео. Seedream/Qwen/Wan/FLUX/видео идут через Kie.ai.
# Nano Banana 2 и Nano Banana Pro идут только через GRS AI, без Kie fallback.
KIE_ENABLED=false
KIE_API_KEY=
GRS_API_KEY=
KIE_BASE_URL=https://api.kie.ai/api/v1
GRS_BASE_URL=https://grsaiapi.com
# Временная загрузка Telegram-референсов перед provider call.
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_TIMEOUT_SECONDS=60
KIE_POLL_INTERVAL_SECONDS=4
KIE_TASK_TIMEOUT_SECONDS=900
KIE_MAX_CONCURRENT_GENERATIONS=4
KIE_GENERATION_MAX_ATTEMPTS=50

# Kie.ai: изображения.
KIE_SEEDREAM_5_PRO_TEXT_MODEL=seedream/5-pro-text-to-image
KIE_SEEDREAM_5_PRO_IMAGE_MODEL=seedream/5-pro-image-to-image
# Старый параметр поддерживается только как Seedream image-to-image fallback.
KIE_SEEDREAM_5_PRO_MODEL=
KIE_QWEN2_IMAGE_EDIT_MODEL=qwen2/image-edit
KIE_WAN_27_IMAGE_MODEL=wan/2-7-image
KIE_FLUX_2_PRO_IMAGE_MODEL=flux-2/pro-image-to-image

# GRS AI: изображения.
GRS_NANO_BANANA_2_MODEL=nano-banana-2
GRS_NANO_BANANA_PRO_MODEL=nano-banana-pro

# Kie.ai: видео.
KIE_GROK_IMAGINE_IMAGE_TO_VIDEO_MODEL=grok-imagine/image-to-video
KIE_GROK_IMAGINE_VIDEO_15_MODEL=grok-imagine-video-1-5-preview
# Legacy-параметр читается только как fallback, если новая переменная отсутствует.
KIE_GROK_IMAGINE_VIDEO_MODEL=
KIE_SEEDANCE_15_PRO_MODEL=bytedance/seedance-1.5-pro
KIE_WAN_27_IMAGE_TO_VIDEO_MODEL=wan/2-7-image-to-video
KIE_WAN_26_IMAGE_TO_VIDEO_MODEL=

# Ручной бюджетный курс. Обновляется в server env; бот не делает скрытых
# внешних запросов к валютным сервисам перед каждой генерацией.
KIE_USD_TO_RUB=
KIE_CREDIT_USD=0.005
KIE_CREDIT_BYN=0.019
# Себестоимость без наценки. Значения можно обновлять без изменения кода.
KIE_SEEDREAM_BASIC_USD=0.075
KIE_SEEDREAM_HIGH_USD=0.15
GRS_NANO_BANANA_2_USD=0.02
GRS_NANO_BANANA_PRO_USD=0.03
KIE_QWEN2_IMAGE_EDIT_USD=0.02
KIE_WAN_27_IMAGE_1K_USD=0.05
KIE_WAN_27_IMAGE_2K_USD=0.08
KIE_FLUX_2_PRO_IMAGE_1K_USD=0.045
KIE_FLUX_2_PRO_IMAGE_2K_USD=0.075
KIE_GROK_480P_USD_PER_SECOND=0.008
KIE_GROK_720P_USD_PER_SECOND=0.015
KIE_GROK_15_480P_USD_PER_SECOND=0.0725
KIE_GROK_15_720P_USD_PER_SECOND=0.125
KIE_SEEDANCE_15_480P_NO_AUDIO_USD_PER_SECOND=0.00875
KIE_SEEDANCE_15_720P_NO_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_1080P_NO_AUDIO_USD_PER_SECOND=0.0375
KIE_SEEDANCE_15_480P_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_720P_AUDIO_USD_PER_SECOND=0.035
KIE_SEEDANCE_15_1080P_AUDIO_USD_PER_SECOND=0.075
KIE_WAN_27_720P_USD_PER_SECOND=0.08
KIE_WAN_27_1080P_USD_PER_SECOND=0.12
KIE_WAN_26_720P_USD_PER_SECOND=
KIE_WAN_26_1080P_USD_PER_SECOND=

# Локальный bridge для нанесения водяного знака через Krita. После полного
# переноса на сервер эта функция остаётся выключенной, пока не появится
# отдельный удалённый обработчик изображений.
KRITA_WATERMARK_ENABLED=false
KRITA_BRIDGE_DIR=C:\Users\username\VelvetKritaBridge
KRITA_PROCESSING_STALE_SECONDS=600

# Совместимость специализированного watermark-хранилища.
WATERMARK_STORAGE_CHAT_ID=-1004459280894
WATERMARK_STORAGE_THREAD_ID=3

# Единый Telegram Storage Center. Реальные message_thread_id форума:
# 3 Watermarks Final, 4 DB Backups Encrypted, 9 Diagnostics Incidents,
# 11 Exports Reports, 7 Codex Patches, 13 Releases Emergency, 15 Rework Review.
TELEGRAM_STORAGE_CHAT_ID=-1004459280894
STORAGE_THREAD_WATERMARKS=3
STORAGE_THREAD_BACKUPS=4
STORAGE_THREAD_DIAGNOSTICS=9
STORAGE_THREAD_EXPORTS=11
STORAGE_THREAD_CODEX=7
STORAGE_THREAD_RELEASES=13
STORAGE_THREAD_REWORK=15
STORAGE_MIGRATE_ON_START=true
STORAGE_SCAN_INTERVAL_SECONDS=3600
STORAGE_DELETE_AFTER_UPLOAD=true
STORAGE_ACTIVE_FILE_GRACE_SECONDS=600
STORAGE_MAX_PART_BYTES=47185920
STORAGE_STAGING_DIR=runtime/telegram-storage
STORAGE_EXPORT_DIRS=exports;reports;runtime/exports;runtime/reports
STORAGE_RELEASE_DIRS=releases;dist;runtime/releases
# Отдельный секрет предпочтителен. Если поле пустое, используется SUPERVISOR_TOKEN,
# затем BOT_TOKEN. Не меняйте секрет, пока нужны старые encrypted backup.
STORAGE_ENCRYPTION_SECRET=replace_with_random_secret_at_least_24_characters

# Внешний Supervisor запускает main.py, собирает логи, перезапускает бот и
# выполняет безопасные обновления. На Linux-сервере он будет адаптирован под
# Docker/systemd; Windows-параметры ниже нужны только до завершения переезда.
SUPERVISOR_ENABLED=false
SUPERVISOR_TOKEN=replace_with_random_token_at_least_24_characters
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8765
SUPERVISOR_BASE_URL=http://127.0.0.1:8765
SUPERVISOR_ALLOW_REMOTE=false
SUPERVISOR_PROJECT_DIR=.
SUPERVISOR_PYTHON=.venv314\Scripts\python.exe
SUPERVISOR_BOT_COMMAND=".venv314\Scripts\python.exe" main.py
SUPERVISOR_TEST_COMMAND=".venv314\Scripts\python.exe" -m unittest discover -s tests -v
# Отдельная тестовая БД для PostgreSQL integration tests во время update.
# Если не задана, Supervisor запускает только тесты без TEST_DATABASE_URL.
SUPERVISOR_TEST_DATABASE_URL=
# Необязательное имя изолированной схемы внутри тестовой БД.
TEST_DATABASE_SCHEMA=
SUPERVISOR_TASK_NAME=VelvetSupervisor
SUPERVISOR_AUTO_RESTART=true
SUPERVISOR_MAX_RESTARTS=3
SUPERVISOR_RESTART_WINDOW_SECONDS=600
SUPERVISOR_STARTUP_GRACE_SECONDS=12
SUPERVISOR_COMMAND_TIMEOUT_SECONDS=900
SUPERVISOR_CLIENT_TIMEOUT_SECONDS=20
SUPERVISOR_UPDATE_REMOTE=origin
SUPERVISOR_UPDATE_BRANCH=main
SUPERVISOR_LOG_DIR=logs
SUPERVISOR_RUNTIME_DIR=runtime/supervisor
SUPERVISOR_NOTIFICATION_CHAT_ID=
SUPERVISOR_NOTIFICATION_BOT_TOKEN=
# Необязательно. По умолчанию критические уведомления дублируются всем ID из
# ALLOWED_USER_IDS. Можно задать отдельный список Telegram ID через запятую.
SUPERVISOR_NOTIFICATION_OWNER_IDS=
SUPERVISOR_MAX_LOG_LINES=2000

# Hermes получает incident только после повторных падений. API слушает только
# loopback-порт VPS; ключ должен совпадать с API_SERVER_KEY в .env.hermes.
HERMES_INCIDENT_ENABLED=false
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace_with_internal_hermes_api_key
HERMES_TIMEOUT_SECONDS=20
HERMES_ESCALATE_AFTER_RESTARTS=2
HERMES_INCIDENT_COOLDOWN_SECONDS=600
HERMES_MAX_LOG_CHARS=12000

# Codex CLI на сервере использует Byesu Responses API. Ключ хранится в
# ~/.codex/auth.json пользователя агента, а не в репозитории или Telegram.
CODEX_ENABLED=false
CODEX_COMMAND=codex exec --json --sandbox workspace-write -
CODEX_MODEL=gpt-5.5
CODEX_TIMEOUT_SECONDS=1800
CODEX_WORKTREE_DIR=runtime/supervisor/codex-worktrees
CODEX_PUSH_REMOTE=origin

# Backup encryption key lifecycle.
# Active secret must be independent from BOT_TOKEN and SUPERVISOR_TOKEN.
STORAGE_ENCRYPTION_ACTIVE_KEY_ID=primary-2026-08
STORAGE_ENCRYPTION_SECRET=replace_with_random_backup_secret_at_least_32_chars
# JSON object with read-only historical keys retained for restore.
STORAGE_ENCRYPTION_KEYRING={}
# Set only during migration of VELVET-AESGCM1 backups without header key ID.
STORAGE_ENCRYPTION_LEGACY_KEY_ID=
