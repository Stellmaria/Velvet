# Скопируйте в .env.hermes только на сервере.
# Файл .env.hermes не должен попадать в Git.

# Два физических Byesu API key:
# 1) Hermes-Codex: текстовые модели Каэля/coder fallback и анализ GPT Image 2.
#    OPENAI_API_KEY и BYESU_HERMES_CODEX_API_KEY должны содержать одно и то же
#    физическое значение, потому что основной Hermes пока читает legacy alias.
# 2) Media Gen: только платные image endpoints GPT Image 2 fallback.
OPENAI_API_KEY=replace_with_hermes_codex_byesu_key
BYESU_HERMES_CODEX_API_KEY=replace_with_same_hermes_codex_byesu_key
BYESU_MEDIA_GEN_API_KEY=replace_with_distinct_media_gen_byesu_key

TELEGRAM_BOT_TOKEN=replace_with_separate_kael_bot_token
TELEGRAM_ALLOWED_USERS=replace_with_owner_numeric_telegram_id

# GPT Image 2 остаётся Codex-first для 1K/2K/4K. Byesu разрешается только после
# явно подтверждённого subscription limit. Включайте fallback лишь после live
# capability smoke обоих ключей.
CODEX_IMAGE_LIMIT_PREFLIGHT_ENABLED=true
CODEX_IMAGE_LIMIT_PREFLIGHT_TIMEOUT_SECONDS=3
CODEX_IMAGE_BYESU_FALLBACK_ENABLED=false
CODEX_IMAGE_BYESU_BASE_URL=https://byesu.com/v1
CODEX_IMAGE_BYESU_TIMEOUT_SECONDS=600

# Fine-grained GitHub token только для Stellmaria/Velvet. Достаточно Contents и
# Pull requests read/write; Administration, Actions secrets и другие репозитории
# не разрешать. Позже предпочтительно заменить токен отдельным GitHub App.
GH_TOKEN=replace_with_fine_grained_repo_token

# Внутренний OpenAI-compatible API Каэля. Docker публикует порт только на
# 127.0.0.1 VPS. API_SERVER_KEY должен совпадать с HERMES_API_KEY в основном .env.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=replace_with_internal_kael_api_key
API_SERVER_MODEL_NAME=kael
API_SERVER_CORS_ORIGINS=
HERMES_DASHBOARD=0
