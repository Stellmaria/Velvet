# Скопируйте в .env.hermes только на сервере.
# Файл .env.hermes не должен попадать в Git.
OPENAI_API_KEY=replace_with_byesu_api_key
TELEGRAM_BOT_TOKEN=replace_with_separate_hermes_bot_token
TELEGRAM_ALLOWED_USERS=replace_with_owner_numeric_telegram_id

# Hermes работает только через Telegram. API и dashboard по умолчанию наружу
# не публикуются; включать их следует только за reverse proxy и отдельным ключом.
API_SERVER_ENABLED=false
HERMES_DASHBOARD=0
