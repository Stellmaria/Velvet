# Local-first VL contract for canonical issue #630.
# LOCAL_MAIN is the observed production qwen3.5:9b model; keep optional routes off
# until their own benchmark/runtime gates are complete.

AI_VISION_ENABLED=false
AI_VISION_QUEUE_ENABLED=false
# Fail-closed gate for the periodic global quality worker. Keep disabled until
# controlled quality batches are explicitly approved.
AI_QUALITY_ENABLED=false

# LOCAL_MAIN. The bot talks only to the internal provider-neutral gateway.
AI_VISION_PROVIDER=local_openai_compatible
AI_VISION_BASE_URL=http://vision-gateway:8080/v1
AI_VISION_MODEL=qwen3.5:9b
AI_VISION_API_KEY=

# Existing FLASH names remain the compatibility/config surface for LOCAL_MAIN.
AI_VISION_FLASH_MODEL=qwen3.5:9b
AI_VISION_FLASH_INPUT_RUB_PER_1M=0
AI_VISION_FLASH_OUTPUT_RUB_PER_1M=0

# CLOUD_PRO is standard-only and fail-closed. Enabling it additionally requires
# an explicit cloud openai_compatible endpoint, model, key and positive pricing.
AI_VISION_CLOUD_PRO_ENABLED=false
AI_VISION_PRO_PROVIDER=
AI_VISION_PRO_BASE_URL=
AI_VISION_PRO_MODEL=
AI_VISION_PRO_API_KEY=
AI_VISION_PRO_INPUT_RUB_PER_1M=
AI_VISION_PRO_OUTPUT_RUB_PER_1M=

# LOCAL_UNCENSORED is sensitive-only and fail-closed. It must be a distinct
# local model and is considered only after LOCAL_MAIN refusal/error/low confidence
# or an explicit owner force request. Do not enable until the runtime can switch
# the pinned model safely under the single-inference resource budget.
AI_VISION_LOCAL_UNCENSORED_ENABLED=false
AI_VISION_SENSITIVE_PROVIDER=local_openai_compatible
AI_VISION_SENSITIVE_BASE_URL=http://vision-gateway:8080/v1
AI_VISION_SENSITIVE_MODEL=
AI_VISION_SENSITIVE_API_KEY=
AI_VISION_SENSITIVE_INPUT_RUB_PER_1M=0
AI_VISION_SENSITIVE_OUTPUT_RUB_PER_1M=0
# Legacy compatibility variable. Cloud sensitive routing is forbidden regardless.
AI_VISION_ALLOW_CLOUD_SENSITIVE=false

AI_VISION_CASCADE_CONFIDENCE_THRESHOLD=70
AI_VISION_PROMPT_VERSION=1
AI_VISION_TIMEOUT_SECONDS=300
AI_VISION_MAX_ATTEMPTS=3

# Runtime/gateway identity is fail-closed. Production evidence from 2026-08-07
# pins qwen3.5:9b to digest prefix 6488c96fa5fa; loader and gateway reject drift.
VISION_RUNTIME_IMAGE=velvet-vision-runtime:local
VISION_RUNTIME_BASE_IMAGE=ollama/ollama:0.32.3
VISION_GATEWAY_IMAGE=velvet-vision-gateway:local
VISION_MODEL=qwen3.5:9b
VISION_MODEL_EXPECTED_DIGEST=6488c96fa5fa
VISION_RUNTIME_STARTUP_TIMEOUT_SECONDS=1800
VISION_RUNTIME_HEALTH_START_PERIOD=5m

VISION_LOADER_MEMORY_LIMIT=4g
VISION_LOADER_CPU_LIMIT=2.0
VISION_RUNTIME_MEMORY_LIMIT=12g
VISION_RUNTIME_CPU_LIMIT=6.0
VISION_GATEWAY_MEMORY_LIMIT=1g
VISION_GATEWAY_CPU_LIMIT=1.0
VISION_MAX_CONCURRENCY=1
VISION_CONTEXT_TOKENS=8192
VISION_MAX_IMAGE_SIDE=1280
VISION_MAX_IMAGES=8
VISION_MAX_DECODED_IMAGE_BYTES=20971520
VISION_GATEWAY_MAX_REQUEST_BYTES=33554432
VISION_REQUEST_TIMEOUT_SECONDS=300
VISION_KEEP_ALIVE=5m
