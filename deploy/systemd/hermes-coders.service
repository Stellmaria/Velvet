[Unit]
Description=Isolated Hermes Coder gateways for Velvet and Romatic Club Max
Requires=docker.service hermes-sandbox-launcher.socket
After=docker.service hermes-sandbox-launcher.socket network-online.target velvet-compose.service romaticclub-compose.service
Wants=network-online.target hermes-coder-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=velvet
Group=velvet
WorkingDirectory=/srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders
Environment=HERMES_CODERS_ROOT=/srv/hermes-coders
EnvironmentFile=/srv/hermes-coders/launcher.env
ExecStartPre=+/usr/bin/chmod 0644 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_delegate.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_safe_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_provider_chain_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_tier_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_image_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/byesu_image_fallback.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/byesu_image_routing_policy.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_launcher_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_context_launcher_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_launcher_client.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_preflight.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/compose.runtime.yaml
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_source_guard.py
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/ensure_runtime_config.py /srv/hermes-coders/data/velvet/config.yaml /srv/hermes-coders/data/max/config.yaml
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/reconcile_workspaces.py
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/preflight.py
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_preflight.py
ExecStartPre=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml config --quiet
ExecStart=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml up -d --no-build --remove-orphans --no-deps hermes-coder-velvet hermes-coder-max
ExecStartPost=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_smoke.py
ExecStartPost=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py
ExecStop=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml stop --timeout 45 hermes-coder-velvet hermes-coder-max
ExecReload=+/usr/bin/chmod 0644 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_delegate.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_safe_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_provider_chain_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_tier_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_image_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/byesu_image_fallback.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/byesu_image_routing_policy.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_launcher_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_context_launcher_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_launcher_client.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_preflight.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/compose.runtime.yaml
ExecReload=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_source_guard.py
ExecReload=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/sandbox_preflight.py
ExecReload=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml up -d --no-build --remove-orphans --no-deps hermes-coder-velvet hermes-coder-max
ExecReload=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_smoke.py
ExecReload=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
