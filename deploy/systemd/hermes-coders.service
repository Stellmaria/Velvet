[Unit]
Description=Isolated Hermes Coder gateways for Velvet and Romatic Club Max
Requires=docker.service
After=docker.service network-online.target velvet-compose.service romaticclub-compose.service
Wants=network-online.target hermes-coder-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=velvet
Group=velvet
WorkingDirectory=/srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders
Environment=HERMES_CODERS_ROOT=/srv/hermes-coders
Environment=HERMES_CODEX_STRICT_NESTED_PROC_SMOKE=0
ExecStartPre=+/usr/bin/chmod 0644 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_delegate.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_safe_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_provider_chain_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_tier_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/compose.runtime.yaml
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_source_guard.py
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/ensure_runtime_config.py /srv/hermes-coders/data/velvet/config.yaml /srv/hermes-coders/data/max/config.yaml
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/reconcile_workspaces.py
ExecStartPre=+/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/preflight.py
ExecStartPre=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml config --quiet
ExecStart=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml up -d --no-deps --no-build --remove-orphans hermes-coder-velvet hermes-coder-max
ExecStartPost=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_smoke.py
ExecStartPost=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py
ExecStop=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml stop --timeout 45 hermes-coder-velvet hermes-coder-max
ExecReload=+/usr/bin/chmod 0644 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_delegate.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_first_safe_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_provider_chain_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/codex_tier_runner.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/compose.runtime.yaml
ExecReload=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_source_guard.py
ExecReload=/usr/bin/docker compose --project-name hermes-coders --profile velvet --profile max -f compose.yaml -f compose.runtime.yaml -f compose.security.yaml up -d --no-deps --no-build --remove-orphans hermes-coder-velvet hermes-coder-max
ExecReload=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/runtime_smoke.py
ExecReload=/usr/bin/python3 /srv/hermes-coders/releases/current-hermes-coders/deploy/hermes-coders/tier_provider_smoke.py
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
