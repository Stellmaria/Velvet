[Unit]
Description=Prune stale Velvet Docker BuildKit cache
Requires=docker.service
After=docker.service
ConditionPathExists=/srv/velvet/deploy/server/prune-build-cache.sh

[Service]
Type=oneshot
User=velvet
Group=velvet
Environment=DOCKER_CONFIG=/srv/velvet/data/runtime/docker-config
Environment=VELVET_DEPLOY_LOCK=/tmp/velvet-deploy.lock
Environment=VELVET_BUILD_CACHE_PRUNE_AGE=168h
ExecStart=/usr/bin/bash /srv/velvet/deploy/server/prune-build-cache.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/velvet/data/runtime/docker-config /tmp
