[Unit]
Description=Velvet Librarian local Ollama and internal Hermes runtime
Requires=docker.service
After=docker.service velvet-compose.service
Wants=velvet-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=velvet
Group=velvet
WorkingDirectory=/srv/velvet/deploy/hermes-librarian
ExecStart=/usr/bin/bash /srv/velvet/deploy/hermes-librarian/start.sh
ExecStop=/usr/bin/docker compose --env-file /srv/velvet/.env.server -f /srv/velvet/deploy/hermes-librarian/compose.yaml stop
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
