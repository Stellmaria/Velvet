[Unit]
Description=Hermes root-owned per-run Docker sandbox launcher
Requires=docker.service hermes-sandbox-launcher.socket
After=docker.service hermes-sandbox-launcher.socket

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=hermes-sandbox-private
RuntimeDirectoryMode=0700
Environment=PYTHONPATH=/usr/local/lib/hermes-sandbox-launcher/current
EnvironmentFile=/srv/hermes-coders/launcher.env
EnvironmentFile=/srv/hermes-coders/launcher-secrets.env
ExecStart=/usr/bin/python3 /usr/local/lib/hermes-sandbox-launcher/current/launcher.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
ReadOnlyPaths=/usr/local/lib/hermes-sandbox-launcher/current
ReadOnlyPaths=/srv/hermes-coders/codex
ReadOnlyPaths=/srv/hermes-coders/secrets
ReadOnlyPaths=/srv/hermes-coders/launcher-secrets.env
ReadWritePaths=/run/hermes-sandbox
ReadWritePaths=/run/hermes-sandbox-private
ReadWritePaths=/srv/hermes-coders/codex-runs
UMask=0077

[Install]
WantedBy=multi-user.target
