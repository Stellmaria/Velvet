[Unit]
Description=Velvet Server Supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Before=velvet-compose.service

[Service]
Type=simple
User=velvet
Group=velvet
SupplementaryGroups=velvet-supervisor-client
UMask=0007
WorkingDirectory=/srv/velvet
EnvironmentFile=/srv/velvet/.env.server
Environment=VELVET_APP_DIR=/srv/velvet
Environment=VELVET_ENV_FILE=.env.server
Environment=VELVET_COMPOSE_FILE=docker-compose.server.yml
Environment=DOCKER_CONFIG=/srv/velvet/data/runtime/docker-config
Environment=COMPOSE_BAKE=false
ExecStart=/usr/bin/python3 /srv/velvet/scripts/server_supervisor.py
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# deploy.sh and manual SSH deploys share /tmp/velvet-deploy.lock. Keep that
# single lock writable inside the systemd sandbox so both entrypoints serialize.
ReadWritePaths=/srv/velvet /srv/velvet/data /tmp

[Install]
WantedBy=multi-user.target
