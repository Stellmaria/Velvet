# Arthur Librarian Phase 2
#
# Copy only into the server secret env after a dedicated Telegram bot identity
# exists. Never reuse BOT_TOKEN. CI does not create or populate production
# Telegram credentials.
ARTHUR_BOT_TOKEN=
ARTHUR_ALLOWED_USER_IDS=
ARTHUR_ALLOWED_USERNAMES=
ARTHUR_REPORT_CHAT_ID=
ARTHUR_REPORT_THREAD_ID=
ARTHUR_STORAGE_GATEWAY_API_KEY=
ARTHUR_STORAGE_GATEWAY_BASE_URL=http://arthur-storage-gateway:8786

# Persistent host data is prepared at ${VELVET_DATA_DIR:-/srv/velvet/data}/arthur.
# The container path remains /app/runtime/arthur.

# Phase 2 remains manual-first.
STORAGE_LIBRARIAN_AUTO_ENQUEUE=false
