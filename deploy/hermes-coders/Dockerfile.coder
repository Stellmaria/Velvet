ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent@sha256:f7b35053268f532f98955195c909f15a230470fbcbdacaa9fdecb95707dad04a
FROM ${HERMES_BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gh \
        jq \
        make \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="Velvet Hermes Coder" \
      org.opencontainers.image.description="Hermes Agent with durable GitHub and PostgreSQL client tooling"
