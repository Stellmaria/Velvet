#include <tunables/global>

profile hermes-codex-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  userns,
  mount options=(rw, rslave) -> /,
  mount options=(rw, rprivate) -> /,
  mount options=(rw, bind) / -> /,
  mount options=(rw, bind) / -> /**,
  mount options=(ro, remount, bind) / -> /,
  mount options=(ro, remount, bind) /** -> /**,
  mount options=(rw, bind) /dev -> /dev,
  mount options=(rw, rbind) /dev -> /dev,
  mount options=(rw, bind) /workspace -> /workspace,
  mount options=(rw, bind) /workspace/** -> /workspace/**,
  mount fstype=proc -> /proc/,
  umount /**,
  pivot_root,
  network inet stream,
  network inet6 stream,
  / r,
  /** r,
  /bin/sh ix,
  /usr/bin/python ix,
  /usr/bin/python3 ix,
  /usr/local/bin/python ix,
  /usr/local/bin/python3 ix,
  /usr/local/bin/codex ix,
  /usr/bin/bwrap ix,
  /usr/bin/git ix,
  /usr/bin/gh ix,
  /usr/bin/unshare ix,
  /usr/bin/true ix,
  /usr/bin/sha256sum ix,
  /usr/bin/findmnt ix,
  /usr/bin/grep ix,
  /usr/bin/awk ix,
  /usr/bin/stat ix,
  /usr/bin/env ix,
  /usr/bin/bash ix,
  /usr/bin/make ix,
  /usr/bin/pytest ix,
  /usr/local/bin/** ix,
  /usr/** mr,
  /lib/** mr,
  /lib64/** mr,
  /opt/codex/** rwk,
  /opt/codex-runs/** rwk,
  /workspace/** rwk,
  /tmp/** rwk,
  deny /var/run/docker.sock rw,
  deny /run/docker.sock rw,
  deny /proc/sys/** w,
  deny /sys/** w,
}
