#include <tunables/global>

profile hermes-codex-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,

  / r,
  /** r,
  /bin/** ix,
  /usr/bin/** ix,
  /usr/local/bin/** ix,
  /usr/lib/git-core/git ix,
  /usr/lib/git-core/git-remote-http ix,
  /usr/lib/git-core/git-remote-https ix,
  /usr/** mr,
  /lib/** mr,
  /lib64/** mr,

  # Hermes Agent keeps Python packages in this venv. Native extension modules
  # need mmap permission (`m`) to load shared objects, but no write/ix access.
  /opt/hermes/.venv/** mr,

  /opt/codex/ r,
  /opt/codex/** r,
  # Codex app-server always opens its machine installation identity read/write
  # and older pinned CLIs persist it through a same-directory temporary file.
  # Keep the rest of CODEX_HOME read-only and permit only this local identity.
  /opt/codex/installation_id rwk,
  /opt/codex/.tmp* rwk,
  /opt/codex/tmp/ rw,
  /opt/codex/tmp/** rwk,
  /opt/codex-runs/ rw,
  /opt/codex-runs/** rwk,
  /workspace-base/ r,
  /workspace-base/** r,
  /run/hermes-sandbox/ r,
  /run/hermes-sandbox/launcher.sock rw,
  /tmp/ rw,
  /tmp/** rwk,

  deny /workspace/ rwklx,
  deny /workspace/** rwklx,
  deny /run/docker.sock rwklx,
  deny /var/run/docker.sock rwklx,
  deny /proc/sys/** w,
  deny /proc/sysrq-trigger rw,
  deny /sys/** w,
}
