#include <tunables/global>

profile hermes-codex-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,

  / r,
  /** r,
  /bin/** ix,
  /usr/bin/** ix,
  /usr/local/bin/** ix,
  /usr/** mr,
  /lib/** mr,
  /lib64/** mr,

  /opt/codex/ r,
  /opt/codex/** r,
  /opt/codex-runs/ rw,
  /opt/codex-runs/** rwk,
  /workspace-base/ r,
  /workspace-base/** r,
  /run/hermes-sandbox/ r,
  /run/hermes-sandbox/launcher.sock rw,
  /tmp/ rw,
  /tmp/** rwk,

  deny /workspace/ rwklx,
  deny /workspace/** rwklx,
  deny /run/docker.sock rwklx,
  deny /var/run/docker.sock rwklx,
  deny /proc/sys/** w,
  deny /proc/sysrq-trigger rw,
  deny /sys/** w,
}
