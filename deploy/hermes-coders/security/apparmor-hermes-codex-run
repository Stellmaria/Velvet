#include <tunables/global>

profile hermes-codex-run flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  / r,
  /** r,
  /bin/** ix,
  /usr/bin/** ix,
  /usr/local/bin/** ix,
  /usr/** mr,
  /lib/** mr,
  /lib64/** mr,

  /workspace/ rw,
  /workspace/** rwkix,
  /opt/codex/ rw,
  /opt/codex/** rwkix,
  /opt/codex-ro/ r,
  /opt/codex-ro/** r,
  /tmp/ rw,
  /tmp/** rwk,

  deny /run/hermes-sandbox/** rwklx,
  deny /run/docker.sock rwklx,
  deny /var/run/docker.sock rwklx,
  deny /workspace-base/** rwklx,
  deny /opt/codex-runs/** rwklx,
  deny /proc/sys/** w,
  deny /proc/sysrq-trigger rw,
  deny /sys/** w,
}
