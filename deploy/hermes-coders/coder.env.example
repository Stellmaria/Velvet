# Один отдельный файл на каждый coder-контейнер.
# Права на production-файле: 0600.
BYESU_HERMES_CODEX_API_KEY=
# Только Velvet: media / media-gen token для gpt-image-2 и firefly-gpt-image-2.
# Max этот credential получать не должен.
BYESU_HERMES_MEDIA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
GH_TOKEN=

# Codex-first provider fallback.
# Это каталог доступных provider-моделей, а не единая цепочка.
# Tier-aware runner выбирает:
# - small general/read-only/docs: Luna, затем Terra только при capacity;
# - small code: Mini, затем Terra только при capacity;
# - standard: Terra;
# - complex/high_risk: Terra только как degraded isolated-PR route с review_required.
# Permanent model-access errors fail closed, поэтому неподтверждённый Mini
# не превращается молча в более дорогой Terra run.
# BYESU_HERMES_CODEX_API_KEY должен видеть Sol/Terra/Luna через GET /v1/models.
CODEX_PROVIDER_FALLBACK_ENABLED=true
CODEX_PROVIDER_FALLBACK_MODELS=gpt-5.4-mini,gpt-5.6-terra,gpt-5.6-luna
CODEX_PRIMARY_COOLDOWN_SECONDS=1800

# GPT Image 2 provider route использует два явно разделённых credentials:
# - BYESU_HERMES_CODEX_API_KEY: анализ запроса/референсов через GPT-5.6;
# - BYESU_HERMES_MEDIA_API_KEY: только image endpoint.
# Media token должен видеть обе медиамодели через GET /v1/models:
# - 1K + 0–3 референса: gpt-image-2;
# - 1K + 4–6 референсов либо любое 2K/4K: firefly-gpt-image-2.
# Перед каждым 1K runtime читает свежие лимиты через Codex app-server. Только
# явный активный rateLimitReachedType или 100% до будущего resetsAt пропускает
# запуск Codex и сразу отправляет запрос в Byesu. Ошибка/неизвестный ответ probe
# работает fail-open: задача идёт в Codex и сохраняет обычный fallback.
CODEX_IMAGE_LIMIT_PREFLIGHT_ENABLED=true
CODEX_IMAGE_LIMIT_PREFLIGHT_TIMEOUT_SECONDS=3
# 1K сначала расходует Codex Plus, если preflight не подтвердил исчерпание.
# Чистый subscription_limit до первого tool execution всё ещё переключает на
# Byesu. 2K/4K идут сразу в Byesu.
# Несовместимый Codex или media token fail closed до платной генерации; один
# credential не подменяет другой и generic OPENAI/BYESU aliases не используются.
CODEX_IMAGE_BYESU_FALLBACK_ENABLED=false
CODEX_IMAGE_BYESU_BASE_URL=https://byesu.com/v1
CODEX_IMAGE_BYESU_TIMEOUT_SECONDS=600
