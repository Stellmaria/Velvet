# Один отдельный файл на каждый coder-контейнер.
# Права на production-файле: 0600.
BYESU_HERMES_CODEX_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
GH_TOKEN=

# Codex-first provider fallback.
# Это каталог доступных provider-моделей, а не единая цепочка.
# Tier-aware runner выбирает:
# - small general/read-only/docs: Luna, затем Terra только при capacity;
# - small code: Mini, затем Terra только при capacity;
# - standard: Terra;
# - complex/high_risk: Terra только как degraded isolated-PR route с review_required.
# Permanent model-access errors fail closed, поэтому неподтверждённый Mini
# не превращается молча в более дорогой Terra run.
CODEX_PROVIDER_FALLBACK_ENABLED=true
CODEX_PROVIDER_FALLBACK_MODELS=gpt-5.4-mini,gpt-5.6-terra,gpt-5.6-luna

# Единый dynamic availability state разрешает или запрещает primary Codex route
# для coder-задач и GPT Image 2. State хранится в /opt/codex-runs отдельно для
# Velvet и Max. Независимо от известного resets_at выполняется тихий live probe
# каждые 5 часов; при наступлении codex_available_at выполняется дополнительный
# probe, не сдвигающий обязательный пятичасовой цикл.
CODEX_AVAILABILITY_REFRESH_SECONDS=18000

# GPT Image 2 использует тот же dynamic availability flag. Если он true, все
# 1K/2K/4K идут Codex-first. Если false, Velvet сразу использует split-key Byesu
# fallback без обречённой попытки Codex. Явный subscription_limit от реального
# Codex execution немедленно переводит persisted flag в false и best-effort
# читает provider resets_at для codex_available_at.
# Для image endpoint требуется отдельный Media Gen key, который проецируется
# только в Velvet coder; этот файл содержит лишь Hermes/Codex credential.
CODEX_IMAGE_BYESU_FALLBACK_ENABLED=false
CODEX_IMAGE_BYESU_BASE_URL=https://byesu.com/v1
CODEX_IMAGE_BYESU_TIMEOUT_SECONDS=600
