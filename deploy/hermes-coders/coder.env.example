# Один отдельный файл на каждый coder-контейнер.
# Права на production-файле: 0600.
BYESU_HERMES_CODEX_API_KEY=
BYESU_HERMES_GPT_PRO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
GH_TOKEN=

# Codex-first provider fallback.
# Это каталог доступных provider-моделей, а не единая цепочка.
# Tier-aware runner выбирает:
# - small general/read-only/docs: Luna, затем Terra только при capacity;
# - small code: Mini, затем Terra только при capacity;
# - standard: Terra;
# - complex/high_risk: Terra только как degraded isolated-PR route с review_required.
# Permanent model-access errors fail closed, поэтому неподтверждённый Mini
# не превращается молча в более дорогой Terra run.
CODEX_PROVIDER_FALLBACK_ENABLED=true
CODEX_PROVIDER_FALLBACK_MODELS=gpt-5.4-mini,gpt-5.6-terra,gpt-5.6-luna
CODEX_PRIMARY_COOLDOWN_SECONDS=1800

# GPT Image 2 provider route. Используется тот же BYESU_HERMES_CODEX_API_KEY,
# но его token group обязан видеть выбранную gpt-5.6-sol/terra/luna и обе
# медиамодели через GET /v1/models:
# - 1K + 0–3 референса: gpt-image-2;
# - 1K + 4–6 референсов либо любое 2K/4K: firefly-gpt-image-2.
# 1K сначала расходует Codex Plus и переключается на Byesu только после чистого
# subscription_limit до первого tool execution. 2K/4K идут сразу в Byesu.
# Для image endpoint обычно требуется группа media / media-gen. Несовместимый
# token fail closed до платной генерации; секрет нельзя молча подменять.
CODEX_IMAGE_BYESU_FALLBACK_ENABLED=false
CODEX_IMAGE_BYESU_BASE_URL=https://byesu.com/v1
CODEX_IMAGE_BYESU_TIMEOUT_SECONDS=600
