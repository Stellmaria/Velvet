# Скопируйте в .env.server только на VPS.
# Запуск Compose всегда выполняется с --env-file .env.server.
# Не коммитьте заполненный файл и установите chmod 600.

# -----------------------------------------------------------------------------
# Контейнеры и постоянные данные
# -----------------------------------------------------------------------------
VELVET_DATA_DIR=/srv/velvet/data
VELVET_IMAGE=velvet-bot:local
POSTGRES_IMAGE=postgres:17-alpine
VELVET_BOT_MEMORY_LIMIT=4g
VELVET_BOT_CPU_LIMIT=2.0
HERMES_MEMORY_LIMIT=4g
HERMES_CPU_LIMIT=2.0
HERMES_LOOPBACK_PORT=8642
# Перед включением Hermes закрепите конкретный tag или digest вместо latest.
HERMES_IMAGE=nousresearch/hermes-agent:latest

POSTGRES_DB=velvet
POSTGRES_USER=velvet
POSTGRES_PASSWORD=replace_with_random_url_safe_password_at_least_24_characters
# Пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD. Если пароль содержит
# специальные символы URL, закодируйте их percent-encoding.
DATABASE_URL=postgresql://velvet:replace_with_random_url_safe_password_at_least_24_characters@postgres:5432/velvet

# -----------------------------------------------------------------------------
# Telegram и доступ
# -----------------------------------------------------------------------------
BOT_TOKEN=replace_with_velvet_telegram_bot_token
ALLOWED_USER_IDS=replace_with_owner_numeric_telegram_id
ALLOWED_USERNAMES=
MODERATOR_USER_IDS=
LOG_CHAT_ID=
ANALYTICS_CHANNEL_IDS=
ADULT_CHANNEL_ID=-1003951213065
PUBLICATION_TIMEZONE=Europe/Berlin

# -----------------------------------------------------------------------------
# Backups и Telegram Storage
# -----------------------------------------------------------------------------
BACKUP_DIR=/app/backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
TELEGRAM_STORAGE_CHAT_ID=-1004459280894
STORAGE_THREAD_WATERMARKS=3
STORAGE_THREAD_BACKUPS=4
STORAGE_THREAD_DIAGNOSTICS=9
STORAGE_THREAD_EXPORTS=11
STORAGE_THREAD_CODEX=7
STORAGE_THREAD_RELEASES=13
STORAGE_THREAD_REWORK=15
# Первый production boot выполняется без автоматического Windows-backfill.
# Включите один раз только после проверки прав бота во всех ветках.
STORAGE_MIGRATE_ON_START=false
STORAGE_SCAN_INTERVAL_SECONDS=3600
STORAGE_DELETE_AFTER_UPLOAD=true
STORAGE_ACTIVE_FILE_GRACE_SECONDS=600
STORAGE_MAX_PART_BYTES=47185920
STORAGE_STAGING_DIR=/app/runtime/telegram-storage
STORAGE_EXPORT_DIRS=/app/runtime/exports;/app/runtime/reports
STORAGE_RELEASE_DIRS=/app/runtime/releases
STORAGE_ENCRYPTION_SECRET=replace_with_random_storage_secret_at_least_32_characters
WATERMARK_STORAGE_CHAT_ID=-1004459280894
WATERMARK_STORAGE_THREAD_ID=3

# -----------------------------------------------------------------------------
# Безопасный первый запуск: платные и агентные функции выключены
# -----------------------------------------------------------------------------
AI_BUDGET_ENABLED=true
AI_DAILY_BUDGET_RUB=500
AI_MONTHLY_BUDGET_RUB=5000
AI_MAX_REQUEST_RUB=250
AI_HERMES_RESERVE_RUB=300
AI_BUDGET_WARNING_PERCENTS=70,85,95

AI_TEXT_ENABLED=false
AI_VISION_ENABLED=false
AI_VISION_QUEUE_ENABLED=false
# Отдельный fail-closed gate для фонового global quality worker. Наличие общего
# VL не должно само по себе запускать массовую проверку всего архива.
AI_QUALITY_ENABLED=false
KIE_ENABLED=false
HERMES_INCIDENT_ENABLED=false
CODEX_ENABLED=false
KRITA_WATERMARK_ENABLED=false

# -----------------------------------------------------------------------------
# Облачный RP. Заполнять и включать только после live model smoke-test.
# -----------------------------------------------------------------------------
BYESU_API_KEY=
AI_TEXT_PROVIDER=openai_compatible
AI_TEXT_BASE_URL=https://byesu.com/v1
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
AI_TEXT_TIMEOUT_SECONDS=300
AI_TEXT_MAX_ATTEMPTS=2
AI_TEXT_MAX_OUTPUT_TOKENS=3000
AI_TEXT_MAX_HISTORY_MESSAGES=40
AI_TEXT_INPUT_RUB_PER_1M=
AI_TEXT_OUTPUT_RUB_PER_1M=
AI_TEXT_FALLBACK_PROVIDER=
AI_TEXT_FALLBACK_BASE_URL=https://byesu.com/v1
AI_TEXT_FALLBACK_MODEL=
AI_TEXT_FALLBACK_API_KEY=
AI_TEXT_FALLBACK_INPUT_RUB_PER_1M=
AI_TEXT_FALLBACK_OUTPUT_RUB_PER_1M=

# -----------------------------------------------------------------------------
# Local-first VL cascade. LOCAL_MAIN всегда первый. CLOUD_PRO доступен только
# standard route, LOCAL_UNCENSORED только adult-confirmed sensitive route.
# Оба optional route fail-closed до отдельного runtime/benchmark решения.
# -----------------------------------------------------------------------------
AI_VISION_PROVIDER=local_openai_compatible
AI_VISION_BASE_URL=http://vision-gateway:8080/v1
AI_VISION_MODEL=qwen3.5:9b
AI_VISION_COMPARE_MODEL=
AI_VISION_FALLBACK_MODEL=qwen3.5:9b
AI_VISION_API_KEY=
AI_VISION_TIMEOUT_SECONDS=300
AI_VISION_MAX_ATTEMPTS=3
AI_VISION_CASCADE_CONFIDENCE_THRESHOLD=70
AI_VISION_PROMPT_VERSION=1
AI_VISION_BATCH_PLAN_TTL_SECONDS=900

# Compatibility/config surface for LOCAL_MAIN.
AI_VISION_FLASH_PROVIDER=
AI_VISION_FLASH_BASE_URL=
AI_VISION_FLASH_MODEL=qwen3.5:9b
AI_VISION_FLASH_API_KEY=
AI_VISION_FLASH_TIMEOUT_SECONDS=300
AI_VISION_FLASH_MAX_ATTEMPTS=2
AI_VISION_FLASH_INPUT_RUB_PER_1M=0
AI_VISION_FLASH_OUTPUT_RUB_PER_1M=0

# CLOUD_PRO. Standard-only, never sensitive/private. Включение требует отдельного
# openai_compatible cloud endpoint, модели, API key и положительной цены.
AI_VISION_CLOUD_PRO_ENABLED=false
AI_VISION_PRO_PROVIDER=
AI_VISION_PRO_BASE_URL=
AI_VISION_PRO_MODEL=
AI_VISION_PRO_API_KEY=
AI_VISION_PRO_TIMEOUT_SECONDS=300
AI_VISION_PRO_MAX_ATTEMPTS=2
AI_VISION_PRO_INPUT_RUB_PER_1M=
AI_VISION_PRO_OUTPUT_RUB_PER_1M=

# LOCAL_UNCENSORED. Sensitive-only и обязательно отдельная локальная модель.
# Не включать до готовности multi-model runtime/switching под single-inference budget.
AI_VISION_LOCAL_UNCENSORED_ENABLED=false
AI_VISION_SENSITIVE_PROVIDER=local_openai_compatible
AI_VISION_SENSITIVE_BASE_URL=http://vision-gateway:8080/v1
AI_VISION_SENSITIVE_MODEL=
AI_VISION_SENSITIVE_API_KEY=
AI_VISION_SENSITIVE_TIMEOUT_SECONDS=300
AI_VISION_SENSITIVE_MAX_ATTEMPTS=2
AI_VISION_SENSITIVE_INPUT_RUB_PER_1M=0
AI_VISION_SENSITIVE_OUTPUT_RUB_PER_1M=0
# Legacy compatibility variable. Cloud sensitive routing запрещён независимо.
AI_VISION_ALLOW_CLOUD_SENSITIVE=false

# Локальный VL runtime. Модель устанавливается one-shot профилем
# vision-bootstrap; production runtime не имеет интернет-доступа. Текущий
# production LOCAL_MAIN закреплён по наблюдаемому model id и digest prefix.
VISION_RUNTIME_IMAGE=velvet-vision-runtime:local
VISION_RUNTIME_BASE_IMAGE=ollama/ollama:0.32.3
VISION_GATEWAY_IMAGE=velvet-vision-gateway:local
VISION_MODEL=qwen3.5:9b
VISION_MODEL_EXPECTED_DIGEST=6488c96fa5fa
VISION_RUNTIME_STARTUP_TIMEOUT_SECONDS=1800
VISION_RUNTIME_HEALTH_START_PERIOD=5m
VISION_LOADER_MEMORY_LIMIT=4g
VISION_LOADER_CPU_LIMIT=2.0
VISION_RUNTIME_MEMORY_LIMIT=12g
VISION_RUNTIME_CPU_LIMIT=6.0
VISION_GATEWAY_MEMORY_LIMIT=1g
VISION_GATEWAY_CPU_LIMIT=1.0
VISION_MAX_CONCURRENCY=1
VISION_CONTEXT_TOKENS=8192
VISION_MAX_IMAGE_SIDE=1280
VISION_MAX_IMAGES=8
VISION_MAX_DECODED_IMAGE_BYTES=20971520
VISION_GATEWAY_MAX_REQUEST_BYTES=33554432
VISION_REQUEST_TIMEOUT_SECONDS=300
VISION_KEEP_ALIVE=5m

# -----------------------------------------------------------------------------
# Kie + GRS media generation. Banana 2/Pro работают только через GRS AI; активные изображения: Banana 2, Banana Pro, Seedream, Wan 2.7 и Wan 2.7 Pro.
# Включать после live-проверки моделей, цен и баланса обоих провайдеров.
# -----------------------------------------------------------------------------
KIE_API_KEY=
GRS_API_KEY=
KIE_BASE_URL=https://api.kie.ai/api/v1
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
GRS_BASE_URL=https://grsaiapi.com
KIE_TIMEOUT_SECONDS=60
KIE_POLL_INTERVAL_SECONDS=4
KIE_TASK_TIMEOUT_SECONDS=900
KIE_MAX_CONCURRENT_GENERATIONS=4
KIE_GENERATION_MAX_ATTEMPTS=50

# Kie.ai: изображения.
KIE_SEEDREAM_5_PRO_TEXT_MODEL=seedream/5-pro-text-to-image
KIE_SEEDREAM_5_PRO_IMAGE_MODEL=seedream/5-pro-image-to-image
# Legacy fallback оставлен только для старых Seedream deployment-конфигураций.
KIE_SEEDREAM_5_PRO_MODEL=seedream/5-pro-image-to-image
KIE_WAN_27_IMAGE_MODEL=wan/2-7-image
KIE_WAN_27_IMAGE_PRO_MODEL=wan/2-7-image-pro

# GRS AI: обе Banana без Kie fallback.
GRS_NANO_BANANA_2_MODEL=nano-banana-2
GRS_NANO_BANANA_PRO_MODEL=nano-banana-pro

# Kie.ai: видео.
KIE_GROK_IMAGINE_IMAGE_TO_VIDEO_MODEL=grok-imagine/image-to-video
KIE_GROK_IMAGINE_VIDEO_15_MODEL=grok-imagine-video-1-5-preview
KIE_GROK_IMAGINE_VIDEO_MODEL=
KIE_SEEDANCE_15_PRO_MODEL=bytedance/seedance-1.5-pro
KIE_WAN_27_IMAGE_TO_VIDEO_MODEL=wan/2-7-image-to-video
KIE_WAN_26_IMAGE_TO_VIDEO_MODEL=

KIE_USD_TO_RUB=0
KIE_CREDIT_USD=0.005
KIE_CREDIT_BYN=0.019
KIE_SEEDREAM_BASIC_USD=0.075
KIE_SEEDREAM_HIGH_USD=0.15
GRS_NANO_BANANA_2_USD=0.02
GRS_NANO_BANANA_PRO_USD=0.03
KIE_WAN_27_IMAGE_1K_USD=0.03
KIE_WAN_27_IMAGE_2K_USD=0.03
KIE_WAN_27_IMAGE_PRO_1K_USD=0.075
KIE_WAN_27_IMAGE_PRO_2K_USD=0.075
KIE_WAN_27_IMAGE_PRO_4K_USD=0.075
KIE_GROK_480P_USD_PER_SECOND=0.008
KIE_GROK_720P_USD_PER_SECOND=0.015
KIE_GROK_15_480P_USD_PER_SECOND=0.0725
KIE_GROK_15_720P_USD_PER_SECOND=0.125
KIE_SEEDANCE_15_480P_NO_AUDIO_USD_PER_SECOND=0.00875
KIE_SEEDANCE_15_720P_NO_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_1080P_NO_AUDIO_USD_PER_SECOND=0.0375
KIE_SEEDANCE_15_480P_AUDIO_USD_PER_SECOND=0.0175
KIE_SEEDANCE_15_720P_AUDIO_USD_PER_SECOND=0.035
KIE_SEEDANCE_15_1080P_AUDIO_USD_PER_SECOND=0.075
KIE_WAN_27_720P_USD_PER_SECOND=0.08
KIE_WAN_27_1080P_USD_PER_SECOND=0.12
KIE_WAN_26_720P_USD_PER_SECOND=
KIE_WAN_26_1080P_USD_PER_SECOND=

# Один официальный запрос НБРБ за календарный день Минска.
KIE_NBRB_RATE_ENABLED=true
KIE_NBRB_BASE_URL=https://api.nbrb.by
KIE_NBRB_TIMEOUT_SECONDS=20
KIE_NBRB_TIMEZONE=Europe/Minsk

# -----------------------------------------------------------------------------
# Supervisor / Hermes / Codex
# -----------------------------------------------------------------------------
SUPERVISOR_ENABLED=false
SUPERVISOR_TOKEN=replace_with_random_supervisor_secret_at_least_32_characters
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8765
SUPERVISOR_BASE_URL=http://127.0.0.1:8765
SUPERVISOR_ALLOW_REMOTE=false
SUPERVISOR_PROJECT_DIR=/app
SUPERVISOR_AUTO_RESTART=true
SUPERVISOR_MAX_RESTARTS=3
SUPERVISOR_RESTART_WINDOW_SECONDS=600
SUPERVISOR_STARTUP_GRACE_SECONDS=20
SUPERVISOR_COMMAND_TIMEOUT_SECONDS=900
SUPERVISOR_CLIENT_TIMEOUT_SECONDS=20
SUPERVISOR_UPDATE_REMOTE=origin
SUPERVISOR_UPDATE_BRANCH=main
SUPERVISOR_LOG_DIR=/app/logs
SUPERVISOR_RUNTIME_DIR=/app/runtime/supervisor
SUPERVISOR_NOTIFICATION_CHAT_ID=
SUPERVISOR_NOTIFICATION_BOT_TOKEN=
SUPERVISOR_NOTIFICATION_OWNER_IDS=
SUPERVISOR_MAX_LOG_LINES=2000
SUPERVISOR_TEST_DATABASE_URL=
TEST_DATABASE_SCHEMA=

# В Docker bot обращается к Hermes по имени сервиса, не через localhost.
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=replace_with_same_value_as_API_SERVER_KEY_in_env_hermes
HERMES_TIMEOUT_SECONDS=20
HERMES_ESCALATE_AFTER_RESTARTS=2
HERMES_INCIDENT_COOLDOWN_SECONDS=600
HERMES_MAX_LOG_CHARS=12000

# Read-only Codex ChatGPT subscription limits through the internal coder router.
CODEX_LIMITS_BASE_URL=http://hermes-coder-router:8878
CODEX_LIMITS_API_KEY=replace_with_same_value_as_HERMES_OPS_CLIENT_TOKEN

CODEX_COMMAND=codex exec --json --sandbox workspace-write -
CODEX_MODEL=gpt-5.5
CODEX_TIMEOUT_SECONDS=1800
CODEX_WORKTREE_DIR=/app/runtime/supervisor/codex-worktrees
CODEX_PUSH_REMOTE=origin

# Backup encryption key lifecycle.
# Active secret must be independent from BOT_TOKEN and SUPERVISOR_TOKEN.
STORAGE_ENCRYPTION_ACTIVE_KEY_ID=primary-2026-08
STORAGE_ENCRYPTION_SECRET=replace_with_random_backup_secret_at_least_32_chars
# JSON object with read-only historical keys retained for restore.
STORAGE_ENCRYPTION_KEYRING={}
# Set only during migration of VELVET-AESGCM1 backups without header key ID.
STORAGE_ENCRYPTION_LEGACY_KEY_ID=
# Storage Librarian remains manual-first. Text analysis calls private Ollama
# directly; /storage_ask keeps the dedicated Hermes Runs API.
STORAGE_LIBRARIAN_ENABLED=false
STORAGE_LIBRARIAN_AUTO_ENQUEUE=false
STORAGE_LIBRARIAN_OLLAMA_BASE_URL=http://ollama-librarian:11434
STORAGE_LIBRARIAN_TEXT_MODEL=velvet-librarian-text:v1
STORAGE_LIBRARIAN_VISION_MODEL=velvet-librarian-vision:v1
STORAGE_LIBRARIAN_TEXT_CONTEXT_LENGTH=8192
STORAGE_LIBRARIAN_TEXT_MAX_OUTPUT_TOKENS=384
STORAGE_LIBRARIAN_VISION_CONTEXT_LENGTH=16384
STORAGE_LIBRARIAN_VISION_MAX_OUTPUT_TOKENS=640
STORAGE_LIBRARIAN_OLLAMA_KEEP_ALIVE=5m
STORAGE_LIBRARIAN_RUN_TIMEOUT_SECONDS=720
STORAGE_LIBRARIAN_ANALYZER_VERSION=velvet-librarian:qwen3-4b-text:v4